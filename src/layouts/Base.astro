---
import '../styles/theme.css';
import '../styles/global.css';
import '../styles/deco.css';
import '../styles/pages.css';
import '../styles/shine.css';
import '../styles/detail.css';
import '../styles/roman.css';
import '../styles/mobile.css';
import BrandMark from '../components/BrandMark.astro';
import Inscr from '../components/Inscr.astro';
import Seal from '../components/Seal.astro';
import { cssUrl, sprigSvg } from '../lib/roman';
import StudioOverlay from '../components/StudioOverlay.astro';
import { telHref, mailtoHref } from '../lib/site';
import { getSettings, studioOf } from '../lib/content';
import { editor } from '../lib/edit';
import { NAV, FOOTER_NAV, MENU_MORE } from '../lib/nav';

interface Props {
  title: string;
  description: string;
  /** Set for pages that must never be indexed (thank-you, 404). */
  noindex?: boolean;
  /** The home page: full-height hero under a transparent header. */
  home?: boolean;
  /** Extra JSON-LD for this page (no people, no prices). */
  jsonLd?: Record<string, unknown>;
}
const { title, description, noindex = false, home = false, jsonLd } = Astro.props;
// Inside Provident Studio's preview these are the drafts, and `e()` adds the editing annotations (src/lib/edit.ts).
const settings = getSettings(Astro);
const studio = studioOf(Astro);
const e = editor(Astro);
const fullTitle = title.includes(settings.siteName) ? title : `${title} | ${settings.siteName}`;
// One switch for the whole site: until "launched" is ticked in Site settings, nothing is indexed.
const blockIndexing = noindex || !settings.launched;
const pathname = studio?.path ?? Astro.url.pathname;
const canonical = new URL(pathname, settings.siteUrl).href;
const tel = telHref(settings.phone);
const mailto = mailtoHref(settings.email);
const path = pathname.replace(/\/$/, '') || '/';
const year = new Date().getFullYear();
const nav = NAV.filter((l) => l.href !== '/population' || settings.showPopulation);
const words = settings.siteName.split(' ');
const nameTop = words[0];
const nameRest = words.slice(1).join(' ');
const bodyClass = [home && 'home', !settings.launched && 'has-banner'].filter(Boolean).join(' ');
// the laurel sprig used by dividers and notable-coin grades (src/styles/roman.css), drawn once in src/lib/roman.ts
const rootStyle = `--laurel-sprig: ${cssUrl(sprigSvg())}`;
const current = (href: string) => (path === href || path.startsWith(href + '/') ? 'page' : undefined);
---
<!doctype html>
<html lang="en" style={rootStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(blockIndexing || studio) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={settings.siteName} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/cinzel/cinzel-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    {/* the guilloche rosette behind every page title (and the home hero) is the largest thing on a phone's first
        screen; as a CSS background it was only found once the stylesheets had loaded */}
    <link rel="preload" href="/guilloche.svg" as="image" type="image/svg+xml" fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class={bodyClass || undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="intro" />
    <header class="site-header">
      {!settings.launched && <div class="preview-banner" role="note">Preview: draft text, not yet confirmed.</div>}
      <div class="container bar">
        <a class="brand" href="/" aria-label={`${settings.siteName}, home`}>
          <BrandMark />
          <span class="brand-name" aria-hidden="true" {...e('settings', 'siteName', { panel: true })}><b>{nameTop.toUpperCase()}</b>{nameRest && <small>{nameRest}</small>}</span>
        </a>
        <nav class="nav" id="site-nav" aria-label="Main">
          <ul>
            {nav.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
            <li class="nav-contact"><a href="/contact" aria-current={current('/contact')}>Contact</a></li>
          </ul>
          <!-- phone menu only (mobile.css): the remaining pages and how to reach us -->
          <div class="nav-foot">
            <div class="nav-more">{MENU_MORE.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}</div>
            {(settings.phone || settings.location) && (
              <div class="nav-reach">
                {settings.location && <span>{settings.location}</span>}
                {settings.phone && (tel ? <a href={tel}>{settings.phone}</a> : <span>{settings.phone}</span>)}
              </div>
            )}
          </div>
        </nav>
        <a class="header-contact" href="/contact">Contact</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu <i aria-hidden="true"></i></button>
      </div>
    </header>
    <main id="main">
      {home ? <slot /> : <div class="container"><slot /></div>}
    </main>
    <footer class="site-footer">
      <div class="microtext" aria-hidden="true"></div>
      <div class="container">
        <div class="footer-top">
          <div class="footer-brand">
            <a class="brand" href="/" aria-label={`${settings.siteName}, home`}>
              <BrandMark />
              <span class="brand-name" aria-hidden="true"><b>{nameTop.toUpperCase()}</b>{nameRest && <small>{nameRest}</small>}</span>
            </a>
            {settings.footerText && <p {...e('settings', 'footerText')}>{settings.footerText}</p>}
          </div>
          <nav aria-labelledby="f-grading">
            <h2 id="f-grading"><Inscr text="Grading" /></h2>
            <ul>{FOOTER_NAV.grading.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </nav>
          <nav aria-labelledby="f-company">
            <h2 id="f-company"><Inscr text="The company" /></h2>
            <ul>{FOOTER_NAV.company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </nav>
          <div>
            <h2><Inscr text="Contact" /></h2>
            <ul>
              {settings.location && <li {...e('settings', 'location')}>{settings.location}</li>}
              {settings.phone && <li>{tel ? <a href={tel} {...e('settings', 'phone')}>{settings.phone}</a> : <span {...e('settings', 'phone')}>{settings.phone}</span>}</li>}
              {settings.email && <li>{mailto ? <a href={mailto} {...e('settings', 'email')}>{settings.email}</a> : <span {...e('settings', 'email')}>{settings.email}</span>}</li>}
              {settings.hours && <li {...e('settings', 'hours')}>{settings.hours}</li>}
              {settings.socialLinks.map((s, i) => <li><a href={s.url} rel="noopener" {...e('settings', `socialLinks.${i}`, { panel: true })}>{s.label}</a></li>)}
            </ul>
          </div>
        </div>
        <div class="footer-seal" aria-hidden="true"><Seal /></div>
        <div class="footer-legal">
          <span>© {year} {settings.siteName}</span>
          <nav aria-label="Legal">
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms of use</a>
          </nav>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/site';
    </script>
    {studio && <StudioOverlay />}
  </body>
</html>
