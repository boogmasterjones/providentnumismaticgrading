---
import '../styles/theme.css';
import '../styles/global.css';
import '../styles/deco.css';
import '../styles/pages.css';
import '../styles/shine.css';
import '../styles/detail.css';
import BrandMark from '../components/BrandMark.astro';
import { settings, telHref, mailtoHref } from '../lib/site';
import { NAV, FOOTER_NAV } from '../lib/nav';

interface Props {
  title: string;
  description: string;
  /** Set for pages that must never be indexed (thank-you, 404). */
  noindex?: boolean;
  /** The home page: full-height hero under a transparent header. */
  home?: boolean;
  /** Extra JSON-LD for this page (no people, no prices). */
  jsonLd?: Record<string, unknown>;
}
const { title, description, noindex = false, home = false, jsonLd } = Astro.props;
const fullTitle = title.includes(settings.siteName) ? title : `${title} | ${settings.siteName}`;
// One switch for the whole site: until "launched" is ticked in Site settings, nothing is indexed.
const blockIndexing = noindex || !settings.launched;
const canonical = new URL(Astro.url.pathname, settings.siteUrl).href;
const tel = telHref(settings.phone);
const mailto = mailtoHref(settings.email);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const year = new Date().getFullYear();
const nav = NAV.filter((l) => l.href !== '/population' || settings.showPopulation);
const words = settings.siteName.split(' ');
const nameTop = words[0];
const nameRest = words.slice(1).join(' ');
const bodyClass = [home && 'home', !settings.launched && 'has-banner'].filter(Boolean).join(' ');
const current = (href: string) => (path === href || path.startsWith(href + '/') ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {blockIndexing && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={settings.siteName} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class={bodyClass || undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      {!settings.launched && <div class="preview-banner" role="note">Preview: draft text, not yet confirmed.</div>}
      <div class="container bar">
        <a class="brand" href="/" aria-label={`${settings.siteName}, home`}>
          <BrandMark />
          <span class="brand-name" aria-hidden="true"><b>{nameTop.toUpperCase()}</b>{nameRest && <small>{nameRest}</small>}</span>
        </a>
        <nav class="nav" id="site-nav" aria-label="Main">
          <ul>
            {nav.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
            <li class="nav-contact"><a href="/contact" aria-current={current('/contact')}>Contact</a></li>
          </ul>
        </nav>
        <a class="header-contact" href="/contact">Contact</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu <i aria-hidden="true"></i></button>
      </div>
    </header>
    <main id="main">
      {home ? <slot /> : <div class="container"><slot /></div>}
    </main>
    <footer class="site-footer">
      <div class="microtext" aria-hidden="true"></div>
      <div class="container">
        <div class="footer-top">
          <div class="footer-brand">
            <a class="brand" href="/" aria-label={`${settings.siteName}, home`}>
              <BrandMark />
              <span class="brand-name" aria-hidden="true"><b>{nameTop.toUpperCase()}</b>{nameRest && <small>{nameRest}</small>}</span>
            </a>
            <p>Independent authentication, attribution and grading of coins, tokens and medals.</p>
          </div>
          <nav aria-labelledby="f-grading">
            <h2 id="f-grading">Grading</h2>
            <ul>{FOOTER_NAV.grading.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </nav>
          <nav aria-labelledby="f-company">
            <h2 id="f-company">The company</h2>
            <ul>{FOOTER_NAV.company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </nav>
          <div>
            <h2>Contact</h2>
            <ul>
              {settings.location && <li>{settings.location}</li>}
              {settings.phone && <li>{tel ? <a href={tel}>{settings.phone}</a> : settings.phone}</li>}
              {settings.email && <li>{mailto ? <a href={mailto}>{settings.email}</a> : settings.email}</li>}
              {settings.hours && <li>{settings.hours}</li>}
              {settings.socialLinks.map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}
            </ul>
          </div>
        </div>
        <div class="footer-seal" aria-hidden="true"><i></i></div>
        <div class="footer-legal">
          <span>© {year} {settings.siteName}</span>
          <nav aria-label="Legal">
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms of use</a>
          </nav>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
