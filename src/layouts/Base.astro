---
import '../styles/theme.css';
import '../styles/coin-engine.css';
import '../styles/global.css';
import { settings, telHref, mailtoHref } from '../lib/site';
import { NAV } from '../lib/nav';

interface Props {
  title: string;
  description: string;
  /** Set for pages that must never be indexed (thank-you, 404). */
  noindex?: boolean;
  /** The home page: full-width hero under a transparent header. */
  home?: boolean;
}
const { title, description, noindex = false, home = false } = Astro.props;
const fullTitle = title.includes(settings.siteName) ? title : `${title} | ${settings.siteName}`;
// One switch for the whole site: until "launched" is ticked in Site settings, nothing is indexed.
const blockIndexing = noindex || !settings.launched;
const canonical = new URL(Astro.url.pathname, settings.siteUrl).href;
const tel = telHref(settings.phone);
const mailto = mailtoHref(settings.email);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const year = new Date().getFullYear();
const nav = NAV.filter((l) => l.href !== '/population' || settings.showPopulation);
const [nameTop, ...nameRest] = settings.siteName.split(' ');
const bodyClass = [home && 'home', !settings.launched && 'has-banner', tel && 'has-call'].filter(Boolean).join(' ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {blockIndexing && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#07080b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class={bodyClass || undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      {!settings.launched && (
        <div class="preview-banner" role="note">
          <div class="container">Preview: draft text, not yet confirmed.</div>
        </div>
      )}
      <div class="container bar">
        <a class="brand" href="/" aria-label={`${settings.siteName}, home`}>
          <span class="brand-mark" data-coin="crown:gold:8" data-d="40" data-noflip></span>
          <span class="brand-name">{nameTop}<br />{nameRest.slice(0, 1).join(' ')}</span>
        </a>
        <nav class="nav" id="site-nav" aria-label="Main">
          <ul>
            {nav.map((l) => (
              <li><a href={l.href} aria-current={path === l.href || path.startsWith(l.href + '/') ? 'page' : undefined}>{l.label}</a></li>
            ))}
            <li class="nav-submit"><a href="/submit">Submit your coins</a></li>
          </ul>
        </nav>
        <a class="btn header-cta" href="/submit">Submit your coins</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
      </div>
    </header>
    <main id="main">
      {home ? <slot /> : <div class="container"><slot /></div>}
    </main>
    <footer class="site-footer">
      <div class="container">
        <p class="footer-mark" aria-hidden="true">{nameTop.toUpperCase()}</p>
        <div class="cols">
          <div>
            <p><strong>{settings.siteName}</strong></p>
            {settings.tagline && <p>{settings.tagline}</p>}
            {settings.location && <p>{settings.location}</p>}
          </div>
          <div>
            <ul>
              {settings.phone && <li>{tel ? <a href={tel}>{settings.phone}</a> : settings.phone}</li>}
              {settings.email && <li>{mailto ? <a href={mailto}>{settings.email}</a> : settings.email}</li>}
              {settings.hours && <li>{settings.hours}</li>}
            </ul>
            {settings.contactNote && <p class="small">{settings.contactNote}</p>}
            {settings.socialLinks.length > 0 && (
              <ul>
                {settings.socialLinks.map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}
              </ul>
            )}
          </div>
          <div>
            <ul>
              <li><a href="/submit">Submit your coins</a></li>
              <li><a href="/how-to-submit">How to submit</a></li>
              <li><a href="/fees">Fees and turnaround</a></li>
              <li><a href="/verify">Verify a certificate</a></li>
              <li><a href="/faq">FAQ</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-legal">
          <span>© {year} {settings.siteName}</span>
          <a href="/privacy">Privacy</a>
        </div>
      </div>
    </footer>
    {tel && <a class="sticky-call" href={tel}>Call or text {settings.phone}</a>}
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
