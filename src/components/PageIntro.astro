---
interface Props { heading: string; intro?: string; eyebrow?: string }
const { heading, intro, eyebrow } = Astro.props;
---
<header class="page-head">
  <div class="page-river" aria-hidden="true"></div>
  <div class="prose">
    {eyebrow && <p class="eyebrow rv">{eyebrow}</p>}
    <h1 class="rv">{heading}</h1>
    {intro && <p class="lead rv d1">{intro}</p>}
    <slot />
  </div>
</header>
