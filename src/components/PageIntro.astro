---
/** The opening of every inner page: small label, title, intro, and a faint engraved rosette that turns very slowly. */
import { inlineLinks } from '../lib/text';
import { editor } from '../lib/edit';
import Inscr from './Inscr.astro';
interface Props {
  heading: string;
  intro?: string | null;
  eyebrow?: string | null;
  /** the page's document, for Studio's editing annotations (e.g. "page:about") */
  doc?: string;
}
const { heading, intro, eyebrow, doc } = Astro.props;
const e = editor(Astro);
const ed = (path: string, raw?: string | null) => (doc ? e(doc, path, { raw }) : {});
---
<header class="page-head">
  <div class="rosette turn" aria-hidden="true"></div>
  {eyebrow && <p class="eyebrow rv" {...ed('eyebrow', eyebrow)}><Inscr text={eyebrow} /></p>}
  <h1 class="rv d1" {...ed('heading')}>{heading}</h1>
  {intro && <p class="lead rv d2" {...ed('intro')} set:html={inlineLinks(intro)} />}
  <slot />
</header>
