---
/**
 * A full-bleed footage panel (after patek.com). The panel cycles through a short sequence of clips: two stacked
 * <video> elements take turns, the next clip is fetched while the current one plays, and each change is a slow
 * crossfade (about 1 s), so there is never a hard cut or a loop seam (src/scripts/film.ts). It plays only while the
 * panel is on screen. Nothing pins and nothing follows the scroll position. The footage is dimmed and gold-graded in
 * CSS (home.css, "reel"); a caption (eyebrow + one line) fades in over it.
 */
import { roman } from '../lib/text';
import { editor } from '../lib/edit';
import Inscr from './Inscr.astro';
import Ed from './Ed.astro';
import type { Clip } from '../lib/film';

interface Props {
  sequence: Clip[];
  poster: string;
  eyebrow: string;
  title: string;
  index: number;
  /** Studio: the caption's document ("page:home"); captions are film.<index> */
  doc?: string;
}
const { sequence, poster, eyebrow, title, index, doc } = Astro.props;
const id = `reel-${index + 1}`;
const video = { muted: true, playsinline: true, preload: 'none', 'aria-hidden': 'true', tabindex: '-1', disablepictureinpicture: true } as const;
const e = editor(Astro);
const ed = (p: string, raw?: string) => (doc ? e(doc, `film.${index}.${p}`, { raw }) : {});
---
<section class={`reel reel-${index + 1}`} aria-labelledby={id} data-sequence={JSON.stringify(sequence)}>
  <video class="reel-video is-on" poster={poster} {...video}></video>
  <video class="reel-video" {...video}></video>
  <div class="reel-grade" aria-hidden="true"></div>
  <div class="rosette turn reel-rosette" aria-hidden="true"></div>
  <div class="reel-frame deco-frame draw" aria-hidden="true"><i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i></div>
  <div class="reel-caption rv">
    <p class="eyebrow"><span class="numeral">{roman(index + 1)}</span><Ed f={ed('summary', eyebrow)}><Inscr text={eyebrow} /></Ed></p>
    <h2 id={id} {...ed('title')}>{title}</h2>
  </div>
</section>
