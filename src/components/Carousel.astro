---
/**
 * Home photo carousel (Studio → Homepage slideshow). Wide, slow and smooth: a slide every 5 seconds, swipe
 * on phones (native scroll-snap), drag with a mouse, arrows and progress dots (src/scripts/carousel.ts). Pauses on
 * hover, on focus and off screen. Images are lazy-loaded.
 * There are no real photos yet and no stock or AI images may stand in, so until the owner adds photos it shows
 * clearly marked placeholder slides.
 */
import { editor } from '../lib/edit';
import Ed from './Ed.astro';
interface Slide {
  image: string;
  alt: string;
  caption?: string | null;
}
interface Props {
  slides: Slide[];
  /** Studio: where the slides come from ("page:home" + "carousel", or the spare photos "gallery" + "photos") */
  doc?: string;
  path?: string;
}
const { slides, doc, path = 'carousel' } = Astro.props;
const placeholder = slides.length === 0;
const count = placeholder ? 3 : slides.length;
const corners = '<i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>';
const e = editor(Astro);
---
<section class="carousel" aria-roledescription="carousel" aria-label="Photographs" data-carousel>
  <div class="car-track" tabindex="0" aria-live="off" {...(placeholder ? e.add('page:home', 'carousel', 'Add the first slideshow photo') : {})}>
    {placeholder
      ? Array.from({ length: count }, (_, i) => (
          <figure class="car-slide car-ph" aria-roledescription="slide" aria-label={`Placeholder ${i + 1} of ${count}`}>
            <div class="car-mat deco-frame">
              <Fragment set:html={corners} />
              <div class={`rosette turn car-ph-rosette r${i}`} aria-hidden="true"></div>
              <p class="car-ph-text">
                <span class="car-ph-tag">Placeholder</span>
                Photo coming soon
              </p>
            </div>
          </figure>
        ))
      : slides.map((s, i) => (
          <figure class="car-slide" aria-roledescription="slide" aria-label={`${i + 1} of ${count}`} {...(doc ? e.item(doc, path, i, count) : {})}>
            <div class="car-mat deco-frame">
              <Fragment set:html={corners} />
              <img src={s.image} alt={s.alt} loading="lazy" decoding="async" {...(doc ? e(doc, `${path}.${i}.image`) : {})} />
            </div>
            {s.caption && <figcaption><Ed f={doc ? e(doc, `${path}.${i}.caption`) : {}}>{s.caption}</Ed></figcaption>}
          </figure>
        ))}
  </div>
  {count > 1 && (
    <div class="car-ui">
      <button class="car-btn car-prev" type="button" aria-label="Previous photo">
        <svg viewBox="0 0 24 12" aria-hidden="true"><path d="M23 6H1m5-5L1 6l5 5" fill="none" stroke="currentColor" /></svg>
      </button>
      <div class="car-dots">
        {Array.from({ length: count }, (_, i) => (
          <button type="button" class="car-dot" aria-label={`Show photo ${i + 1}`}><i></i></button>
        ))}
      </div>
      <button class="car-btn car-next" type="button" aria-label="Next photo">
        <svg viewBox="0 0 24 12" aria-hidden="true"><path d="M1 6h22m-5-5 5 5-5 5" fill="none" stroke="currentColor" /></svg>
      </button>
    </div>
  )}
</section>
