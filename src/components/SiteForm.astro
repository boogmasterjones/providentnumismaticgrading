---
/**
 * The site's forms post to /api/form (src/pages/api/form.ts), which emails each entry over SMTP to the address in
 * FORM_TO and then shows /thank-you. "form-name" tells the endpoint which form this is (its fields are listed in
 * src/lib/forms.ts: keep them in step). "bot-field" is a honeypot: humans never see it, bots fill it in, and those
 * entries are dropped. The endpoint also limits how many entries one visitor can send.
 */
interface Props { name: string; submitLabel: string; label?: string }
const { name, submitLabel, label } = Astro.props;
---
<form class="stack" name={name} method="POST" action="/api/form" aria-label={label}>
  <input type="hidden" name="form-name" value={name} />
  <p class="hidden-field" aria-hidden="true">
    <label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>
  <div class="form-grid"><slot /></div>
  <div class="form-foot">
    <button class="btn" type="submit">{submitLabel}</button>
    <p class="form-note">Fields marked <span class="req">*</span> are required.</p>
  </div>
</form>
