---
/**
 * The site's monogram: a struck-coin roundel with a serif P, inside a fine laurel wreath (the ancient-Rome accents,
 * 2026-11-02). A drawing, not the client's logo (to confirm).
 */
import { wreathSvg } from '../lib/roman';

interface Props { class?: string }
const { class: cls } = Astro.props;
const beads = Array.from({ length: 48 }, (_, i) => {
  const a = (i / 48) * Math.PI * 2;
  return { x: (32 + 20.2 * Math.cos(a)).toFixed(2), y: (32 + 20.2 * Math.sin(a)).toFixed(2) };
});
const wreath = wreathSvg({ cx: 32, cy: 32, r: 27.4, from: 102, to: 236, leaves: 7, leafLen: 4.4, leafW: 1.3, stroke: 0.5 });
---
<svg class:list={['brand-mark', cls]} viewBox="0 0 64 64" fill="none" stroke="currentColor" aria-hidden="true" focusable="false">
  <g class="laurel" stroke="none" opacity=".8" set:html={wreath} />
  <circle cx="32" cy="32" r="23" stroke-width="0.9" />
  <circle cx="32" cy="32" r="17.6" stroke-width="0.6" />
  {beads.map((b) => <circle cx={b.x} cy={b.y} r="0.55" fill="currentColor" stroke="none" />)}
  <text x="32" y="39.2" text-anchor="middle" fill="currentColor" stroke="none" font-family="Cormorant Garamond, Georgia, serif" font-size="22" font-weight="500">P</text>
</svg>
