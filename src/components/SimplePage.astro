---
import Divider from './Divider.astro';
/** A page that is only editable text: label, heading, intro and body from Keystatic. */
import Base from '../layouts/Base.astro';
import PageIntro from './PageIntro.astro';
import { loadPage } from '../lib/pages';

interface Props { id: string; noindex?: boolean }
const { id, noindex } = Astro.props;
const { data, Content, hasBody } = await loadPage(id);
---
<Base title={data.metaTitle} description={data.metaDescription} noindex={noindex}>
  <PageIntro heading={data.heading} intro={data.intro} eyebrow={data.eyebrow} />
  <div class="page-body">
    {hasBody && <div class="prose rv"><Content /></div>}
    <slot />
    <Divider kind="micro" />
  </div>
</Base>
