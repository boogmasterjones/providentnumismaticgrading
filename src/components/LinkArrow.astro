---
/** A quiet text link with a fine arrow: the site's call to action. */
interface Props { href: string; class?: string }
const { href, class: cls } = Astro.props;
---
<a class:list={['link-arrow', cls]} href={href}><slot /><svg viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M0 5h17M13 1l4 4-4 4" /></svg></a>
