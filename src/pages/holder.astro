---
import Divider from '../components/Divider.astro';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Features from '../components/Features.astro';
import HolderExplode from '../components/HolderExplode.astro';
import Coda from '../components/Coda.astro';
import { loadPage } from '../lib/pages';

const { data, Content, hasBody } = await loadPage('holder');
const sections = data.sections ?? [];
---
<Base title={data.metaTitle} description={data.metaDescription}>
  <PageIntro heading={data.heading} intro={data.intro} eyebrow={data.eyebrow} />
  <div class="page-body">
    <div class="holder-feature">
      <HolderExplode />
      <div class="holder-note rv">
        <p class="eyebrow">Anatomy</p>
        <p class="lead">Five parts, sealed into one: a back shell, an insert that holds the coin without touching its faces, the coin, the label, and a clear front shell welded to the back.</p>
      </div>
    </div>
    <Divider kind="diamond" />
    <Features items={sections} columns={2} />
    {hasBody && <div class="prose rv" style="margin-top: var(--space-6)"><Content /></div>}
  </div>
  <Coda
    title="Check any holder against our registry."
    links={[{ href: '/verify', label: 'Verify a certificate' }, { href: '/contact', label: 'Ask about custom labels' }]}
  />
</Base>
