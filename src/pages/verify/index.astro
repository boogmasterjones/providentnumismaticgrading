---
import Divider from '../../components/Divider.astro';
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { loadPage } from '../../lib/pages';
import { settings, telHref } from '../../lib/site';

const { data, Content, hasBody } = await loadPage('verify');
const tel = telHref(settings.phone);
---
<Base title={data.metaTitle} description={data.metaDescription}>
  <PageIntro heading={data.heading} intro={data.intro} eyebrow={data.eyebrow || 'Certificate registry'} />
  <div class="page-body">
    <div class="cert-panel foil verify-page-panel deco-frame draw">
      <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
      <div class="rosette" aria-hidden="true"></div>
      <form class="verify-form" id="verify-form" action="/verify" method="get" role="search">
        <div class="field">
          <label for="cert">Certificate number</label>
          <div class="inrow">
            <input id="cert" name="cert" type="text" required maxlength="100" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="Number on the label" aria-describedby="cert-hint" />
            <button class="btn" type="submit">Verify</button>
          </div>
          <span class="hint" id="cert-hint">Exactly as printed on the label. Capitals and spaces don't matter.</span>
        </div>
      </form>
      <div class="microtext" aria-hidden="true"></div>
    </div>
    <div id="verify-result" aria-live="polite"></div>
    <noscript><p class="notice info">The lookup needs JavaScript. You can also <a href="/contact">contact us</a> with the certificate number.</p></noscript>

    <template id="not-found-template">
      <div class="notice error">
        <p><strong>No certificate found for "<span data-cert></span>".</strong></p>
        <ul>
          <li>Check the number against the label, character by character (0 and O, 1 and I are easy to mix up).</li>
          <li>A coin graded in the last few days may not be in the registry yet. Try again soon.</li>
          <li>
            If the number is right and still isn't found, <a href="/contact">contact us</a>{tel && <> or call <a href={tel}>{settings.phone}</a></>}
            before buying or selling the coin: the holder may not be one of ours.
          </li>
        </ul>
      </div>
    </template>

    <Divider kind="diamond" />
    {hasBody && <div class="prose"><Content /></div>}
    <p class="muted prose small verify-note">
      A match means this certificate number is on record in our registry with the details shown. Compare them, and the
      photos, with the coin and label in your hand.
    </p>
  </div>
</Base>

<script>
  import type { VerifyResponseBody } from '../../lib/certs/verify';
  import type { Certificate } from '../../lib/certs/certificate';

  const form = document.getElementById('verify-form') as HTMLFormElement;
  const input = document.getElementById('cert') as HTMLInputElement;
  const out = document.getElementById('verify-result') as HTMLDivElement;
  const tpl = document.getElementById('not-found-template') as HTMLTemplateElement;

  /** Build DOM with textContent only: nothing from the database is ever inserted as HTML. */
  function el(tag: string, attrs: Record<string, string> = {}, ...kids: (Node | string)[]) {
    const e = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v);
    e.append(...kids);
    return e;
  }

  function photo(url: string | undefined, side: string, cert: string) {
    return url
      ? el('img', { src: url, alt: `${side} of certificate ${cert}`, loading: 'lazy', decoding: 'async' })
      : el('div', { class: 'photo-placeholder' }, `${side} photo`);
  }

  function card(c: Certificate) {
    const facts: [string, string | undefined][] = [
      ['Certificate number', c.certNumber],
      ['Coin', c.coinDescription],
      ['Year', c.year],
      ['Country / denomination', c.countryDenomination],
      ['Grade', c.grade],
      ['Strike', c.strikeScore],
      ['Surface', c.surfaceScore],
      ['Date graded', c.dateGraded],
    ];
    const dl = el('dl', { class: 'facts' });
    for (const [k, v] of facts) if (v) dl.append(el('dt', {}, k), el('dd', {}, v));
    const head = el(
      'div',
      { class: 'cert-card-head' },
      el('p', { class: c.demo ? 'cert-status demo' : 'cert-status' }, c.demo ? 'Demo record' : 'On record in our registry'),
      el('h2', {}, `Certificate ${c.certNumber}`),
    );
    if (c.demo) head.append(el('span', { class: 'badge demo' }, 'DEMO'));
    const parts: Node[] = [head];
    if (c.demo) {
      parts.push(
        el('p', { class: 'notice warning' }, el('strong', {}, 'Demo record. '), 'The certificate database is not connected yet. This made-up record only previews the page.'),
      );
    }
    parts.push(
      el(
        'div',
        { class: 'cert-card-body' },
        dl,
        el('div', { class: 'coin-photos' }, photo(c.obverseUrl, 'Obverse (front)', c.certNumber), photo(c.reverseUrl, 'Reverse (back)', c.certNumber)),
      ),
    );
    if (c.notes) parts.push(el('p', { class: 'cert-notes' }, c.notes));
    parts.push(
      el(
        'p',
        { class: 'muted small' },
        'This confirms the certificate number exists in our registry with these details. If the coin or label in front of you differs from them, ',
        el('a', { href: '/contact' }, 'contact us'),
        ' before buying or selling it.',
      ),
    );
    return el('article', { class: 'cert-card' }, ...parts);
  }

  async function verify(value: string) {
    out.replaceChildren(el('p', { class: 'muted' }, 'Checking…'));
    try {
      const res = await fetch(`/api/verify?cert=${encodeURIComponent(value)}`, { headers: { Accept: 'application/json' } });
      const body = (await res.json()) as VerifyResponseBody;
      if (!body.ok) {
        out.replaceChildren(el('p', { class: 'notice error' }, body.error ?? 'The lookup is not available right now.'));
        return;
      }
      if (body.found && body.certificate) {
        out.replaceChildren(card(body.certificate));
        return;
      }
      const node = tpl.content.cloneNode(true) as DocumentFragment;
      (node.querySelector('[data-cert]') as HTMLElement).textContent = value;
      const parts: Node[] = [node];
      if (body.mode === 'demo') {
        parts.unshift(el('p', { class: 'notice warning' }, 'Preview: the certificate database is not connected yet. Try DEMO-0001, DEMO-0002 or DEMO-0003.'));
      }
      out.replaceChildren(...parts);
    } catch {
      out.replaceChildren(el('p', { class: 'notice error' }, 'The lookup could not load. Please check your connection and try again.'));
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = input.value.trim();
    if (!v) return;
    history.replaceState(null, '', `?cert=${encodeURIComponent(v)}`);
    void verify(v);
  });

  const fromUrl = new URLSearchParams(location.search).get('cert');
  if (fromUrl) {
    input.value = fromUrl;
    void verify(fromUrl);
  }
</script>
