---
import Base from '../../layouts/Base.astro';
import SampleBadge from '../../components/SampleBadge.astro';
import { getCertificates } from '../../lib/certificates';
import { settings } from '../../lib/site';

export async function getStaticPaths() {
  const certs = await getCertificates();
  return certs.map((cert) => ({ params: { id: cert.id }, props: { cert } }));
}
const { cert } = Astro.props;
const c = cert.data;
const facts: [string, string | null | undefined][] = [
  ['Certificate number', c.certNumber],
  ['Coin', c.coinDescription],
  ['Year', c.year],
  ['Country / denomination', c.countryDenomination],
  ['Grade', c.grade],
  ['Strike', c.strikeScore],
  ['Surface', c.surfaceScore],
  ['Date graded', c.dateGraded],
];
---
<Base
  title={`Certificate ${c.certNumber}`}
  description={`Certificate ${c.certNumber}: ${c.coinDescription}, graded ${c.grade}.`}
  noindex={c.sample}
>
  <p><a href="/verify">← Verify another certificate</a></p>
  <h1>Certificate {c.certNumber} {c.sample && <SampleBadge />}</h1>
  {c.sample && (
    <p class="notice warning"><strong>Sample record.</strong> This is not a real certificate or coin. It exists only to preview the website and will be deleted before launch.</p>
  )}
  {!c.sample && <p class="notice success">This certificate number is on file with {settings.siteName}.</p>}

  <div class="grid">
    <dl class="facts">
      {facts.filter(([, v]) => v).map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
    </dl>
    <div class="coin-photos">
      {c.obverse ? <img src={c.obverse} alt={`Obverse (front) of certificate ${c.certNumber}`} loading="lazy" decoding="async" /> : <div class="photo-placeholder">Obverse photo</div>}
      {c.reverse ? <img src={c.reverse} alt={`Reverse (back) of certificate ${c.certNumber}`} loading="lazy" decoding="async" /> : <div class="photo-placeholder">Reverse photo</div>}
    </div>
  </div>
  {c.notes && <p class="prose" style="white-space: pre-line">{c.notes}</p>}
  <p class="muted prose">
    Compare the coin and the label in your hand with the details and photos above. If anything differs, the holder may
    have been tampered with or copied: <a href="/contact">contact us</a> before buying or selling it.
  </p>
</Base>
