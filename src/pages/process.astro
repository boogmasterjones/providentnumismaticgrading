---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Steps from '../components/Steps.astro';
import Coda from '../components/Coda.astro';
import Body from '../components/Body.astro';
import { loadPage } from '../lib/content';
import { editor } from '../lib/edit';
import { roman } from '../lib/text';

const { data, body, hasBody } = await loadPage(Astro, 'process');
const steps = data.sections ?? [];
const D = 'page:process';
const e = editor(Astro);
---
<Base title={data.metaTitle} description={data.metaDescription}>
  <PageIntro heading={data.heading} intro={data.intro} eyebrow={data.eyebrow} doc={D}>
    <nav class="step-index rv d3" aria-label="Steps">
      {steps.map((s, i) => <a href={`#step-${i + 1}`}><span class="numeral">{roman(i + 1)}</span>{s.title}</a>)}
    </nav>
  </PageIntro>
  <div class="page-body">
    <Steps items={steps} doc={D} />
    {(hasBody || e.on) && <div class="prose rv" style="margin-top: var(--space-6)" {...e(D, 'body')}><Body of={body} /></div>}
  </div>
  <Coda coda={data.coda} doc={D} />
</Base>
