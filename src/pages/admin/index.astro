---
/**
 * Provident Studio, the owner's website editor (signed in only: src/middleware.ts). The app itself is
 * src/studio/App.tsx; it talks to /api/studio/… and shows the real pages through /admin/preview/….
 */
import '../../styles/studio.css';
import App from '../../studio/App';

export const prerender = false;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0b0b0c" />
    <title>Provident Studio</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500;600&display=swap" />
  </head>
  <body class="st-body">
    <App client:only="react" />
    <noscript><p class="st-noscript">Provident Studio needs JavaScript. Turn it on in your browser's settings and reload.</p></noscript>
  </body>
</html>
