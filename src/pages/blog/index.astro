---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { loadPage } from '../../lib/pages';
import { publishedPosts, formatDate } from '../../lib/blog';

const { data, Content, hasBody } = await loadPage('blog');
const posts = await publishedPosts();
---
<Base title={data.metaTitle} description={data.metaDescription}>
  <PageIntro heading={data.heading} intro={data.intro} eyebrow={data.eyebrow} />
  <div class="page-body">
    {hasBody && <div class="prose"><Content /></div>}
    {posts.length === 0 ? (
      <p class="muted">The first articles are in preparation.</p>
    ) : (
      <ul class="post-list">
        {posts.map((p) => (
          <li class="rv">
            <time datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date)}</time>
            <div>
              {p.data.cover && <img src={p.data.cover} alt={p.data.coverAlt ?? ''} loading="lazy" decoding="async" />}
              <h2><a href={`/blog/${p.id}`}>{p.data.title}</a></h2>
              <p class="muted">{p.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
