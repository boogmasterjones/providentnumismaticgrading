---
import Divider from '../../components/Divider.astro';
import Base from '../../layouts/Base.astro';
import Body from '../../components/Body.astro';
import { publishedPosts, formatDate } from '../../lib/blog';
import { getSettings, type Post } from '../../lib/content';
import { editor } from '../../lib/edit';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { post: { id: entry.id, data: entry.data, body: { entry } } } }));
}
interface Props { post: Post }
const { post } = Astro.props;
const settings = getSettings(Astro);
const D = `post:${post.id}`;
const e = editor(Astro);
// The publisher is the company; no personal author (anonymity rule).
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  datePublished: post.data.date.toISOString().slice(0, 10),
  description: post.data.description,
  publisher: { '@type': 'Organization', name: settings.siteName },
  ...(post.data.cover ? { image: new URL(post.data.cover, settings.siteUrl).href } : {}),
};
---
<Base title={post.data.title} description={post.data.description} jsonLd={ld}>
  <article class="post prose">
    <a class="back link-arrow" href="/blog">Journal</a>
    <p class="post-meta"><time datetime={post.data.date.toISOString().slice(0, 10)} {...e(D, 'date', { panel: true })}>{formatDate(post.data.date)}</time></p>
    <h1 {...e(D, 'title')}>{post.data.title}</h1>
    <div class="deco-rule in" aria-hidden="true"><i></i><i></i><i></i></div>
    {post.data.cover && <img src={post.data.cover} alt={post.data.coverAlt ?? ''} decoding="async" {...e(D, 'cover')} />}
    {e.on && !post.data.cover && <p class="sf-empty-img" {...e(D, 'cover')}>Add a cover photo</p>}
    {e.on ? <div {...e(D, 'body')}><Body of={post.body} /></div> : <Body of={post.body} />}
    <Divider kind="laurel" />
  </article>
</Base>
