---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedPosts, formatDate } from '../../lib/blog';
import { settings } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
// The publisher is the company; no personal author (anonymity rule).
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  datePublished: post.data.date.toISOString().slice(0, 10),
  description: post.data.description,
  publisher: { '@type': 'Organization', name: settings.siteName },
  ...(post.data.cover ? { image: new URL(post.data.cover, settings.siteUrl).href } : {}),
};
---
<Base title={post.data.title} description={post.data.description} jsonLd={ld}>
  <article class="post prose">
    <a class="back link-arrow" href="/blog">Journal</a>
    <p class="post-meta"><time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time></p>
    <h1>{post.data.title}</h1>
    <div class="deco-rule in" aria-hidden="true"><i></i><i></i><i></i></div>
    {post.data.cover && <img src={post.data.cover} alt={post.data.coverAlt ?? ''} decoding="async" />}
    <Content />
  </article>
</Base>
