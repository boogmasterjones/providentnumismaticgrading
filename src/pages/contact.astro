---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import NetlifyForm from '../components/NetlifyForm.astro';
import Field from '../components/Field.astro';
import { loadPage } from '../lib/pages';
import { settings, telHref, mailtoHref } from '../lib/site';

const { data, Content, hasBody } = await loadPage('contact');
const tel = telHref(settings.phone);
const mailto = mailtoHref(settings.email);
---
<Base title={data.metaTitle} description={data.metaDescription}>
  <PageIntro heading={data.heading} intro={data.intro} eyebrow="Contact" />
  <div class="two-col">
    <section aria-labelledby="direct" class="rv">
      <h2 id="direct" class="sr-only">Call, text or email</h2>
      <ul class="ways">
        {settings.phone && <li><span>Phone, calls and texts</span>{tel ? <a href={tel}>{settings.phone}</a> : <b>{settings.phone}</b>}</li>}
        {settings.email && <li><span>Email</span>{mailto ? <a href={mailto}>{settings.email}</a> : <b>{settings.email}</b>}</li>}
        {settings.hours && <li><span>Hours</span><b>{settings.hours}</b></li>}
        {settings.location && <li><span>Based in</span><b>{settings.location}</b></li>}
      </ul>
      {settings.contactNote && <p class="muted">{settings.contactNote}</p>}
      {hasBody && <div class="prose"><Content /></div>}
    </section>
    <section aria-labelledby="msg" class="rv d1">
      <h2 id="msg" class="sr-only">Send a message</h2>
      <NetlifyForm name="contact" submitLabel="Send message">
        <Field name="name" label="Your name" required autocomplete="name" />
        <Field name="email" label="Email" type="email" required autocomplete="email" />
        <Field name="phone" label="Phone" type="tel" autocomplete="tel" />
        <Field name="message" label="Message" type="textarea" required rows={6} hint="What are you thinking of sending? A rough count and the kind of coins helps." />
      </NetlifyForm>
    </section>
  </div>
</Base>
