---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { loadPage } from '../lib/pages';
import { fees, feeGroups } from '../lib/site';

const { data, Content, hasBody } = await loadPage('fees');
const groups = feeGroups(fees.tiers);
---
<Base title={data.metaTitle} description={data.metaDescription}>
  <PageIntro heading={data.heading} intro={data.intro} eyebrow="Pricing" />
  {groups.map((g) => (
    <section class="rv" aria-labelledby={`fees-${g.category.replace(/\W+/g, '-').toLowerCase()}`}>
      <h2 id={`fees-${g.category.replace(/\W+/g, '-').toLowerCase()}`}>{g.category}</h2>
      <div class="table-wrap">
        <table class="fee-table">
          <thead>
            <tr><th scope="col">Service</th><th scope="col">Per coin</th><th scope="col">Coin value up to</th><th scope="col">Turnaround</th><th scope="col">Notes</th></tr>
          </thead>
          <tbody>
            {g.tiers.map((t) => (
              <tr><th scope="row">{t.name}</th><td class="price" data-label="Per coin">{t.price}</td><td data-label="Coin value up to">{t.maxValue}</td><td data-label="Turnaround">{t.turnaround}</td><td class="muted" data-label="Notes">{t.notes}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
  <div class="grid">
    {fees.extras.length > 0 && (
      <section class="rv" aria-labelledby="fees-extras">
        <h2 id="fees-extras">Other services</h2>
        <div class="table-wrap">
          <table>
            <tbody>{fees.extras.map((e) => <tr><th scope="row">{e.name}</th><td class="price">{e.price}</td></tr>)}</tbody>
          </table>
        </div>
      </section>
    )}
    {fees.shipping.length > 0 && (
      <section class="rv d1" aria-labelledby="fees-shipping">
        <h2 id="fees-shipping">Shipping</h2>
        <div class="table-wrap">
          <table>
            <tbody>{fees.shipping.map((e) => <tr><th scope="row">{e.name}</th><td class="price">{e.price}</td></tr>)}</tbody>
          </table>
        </div>
      </section>
    )}
  </div>
  {fees.extraNotes.length > 0 && (
    <section class="prose rv" aria-labelledby="fees-notes">
      <h2 id="fees-notes">Good to know</h2>
      <ul>{fees.extraNotes.map((n) => <li>{n}</li>)}</ul>
    </section>
  )}
  {hasBody && <div class="prose"><Content /></div>}
  <div class="actions"><a class="btn" href="/submit">Start a submission</a><a class="btn secondary" href="/contact">Ask for a quote</a></div>
</Base>
