---
import Divider from '../components/Divider.astro';
import '../styles/coin-engine.css';
import Inscr from '../components/Inscr.astro';
import '../styles/home.css';
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Prose from '../components/Prose.astro';
import LinkArrow from '../components/LinkArrow.astro';
import HolderExplode from '../components/HolderExplode.astro';
import Reel from '../components/Reel.astro';
import Carousel from '../components/Carousel.astro';
import Notable from '../components/Notable.astro';
import Intro from '../components/Intro.astro';
import Ed from '../components/Ed.astro';
import Body from '../components/Body.astro';
import { getGallery, getSettings, loadPage } from '../lib/content';
import { editor } from '../lib/edit';
import { roman } from '../lib/text';

const { data, body, hasBody } = await loadPage(Astro, 'home');
const process = await loadPage(Astro, 'process');
const steps = process.data.sections ?? [];
const settings = getSettings(Astro);
const gallery = getGallery(Astro);
// Studio's editing annotations (empty on the public site): src/lib/edit.ts
const e = editor(Astro);
const H = 'page:home';
const words = settings.siteName.split(' ');
const first = words[0];
const rest = words.slice(1).join(' ');
// Two footage panels (after patek.com): each panel cycles through three real coin clips, crossfading (about 1 s)
// from one to the next while it is on screen. Captions come from the CMS (Pages → Home → Film): 'One-line summary' is
// the small line above, 'Title' the one line over the footage. Stock footage from Pexels (see README), dimmed and
// gold-graded in CSS. Phones get the smaller renditions. start/end: the good part of each clip, in seconds.
const F = '/media/film/';
const clips = [
  {
    poster: F + 'silver-poster.webp',
    eyebrow: 'Raking light',
    sequence: [
      { src: F + '5651766-hd_1280_720_25fps.mp4', small: F + '5651766-sd_640_360_25fps.mp4', start: 0.15, end: 6.6 },
      { src: F + '5651775-sd_960_540_25fps.mp4', small: F + '5651775-sd_640_360_25fps.mp4', start: 2, end: 8.4 },
      { src: F + '5651783-sd_960_540_25fps.mp4', small: F + '5651783-sd_640_360_25fps.mp4', start: 1.4, end: 7.6 },
    ],
  },
  {
    poster: F + 'bronze-poster.webp',
    eyebrow: 'Recorded and sealed',
    sequence: [
      { src: F + '7348172-sd_960_506_30fps.mp4', start: 3, end: 10 },
      { src: F + '5253412-sd_640_360_24fps.mp4', start: 7, end: 13.5 },
      { src: F + '5651769-sd_960_540_25fps.mp4', small: F + '5651769-sd_640_360_25fps.mp4', start: 0.2, end: 6 },
    ],
  },
];
const reels = (data.film ?? []).slice(0, clips.length).map((f, i) => ({
  ...clips[i],
  index: i,
  title: f.title,
  eyebrow: f.summary || clips[i].eyebrow,
}));

// Carousel photos: Studio → Homepage slideshow (falls back to the spare photos, then to marked placeholders).
const ownSlides = Boolean(data.carousel?.length);
const slides = (ownSlides ? data.carousel! : gallery.photos).filter((s) => s.image);

// Organization only: no people, no prices (client request, 2026-11-02).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: settings.siteName,
  url: settings.siteUrl,
  description: data.metaDescription,
  ...(settings.phone ? { telephone: settings.phone } : {}),
  ...(settings.location ? { address: { '@type': 'PostalAddress', addressLocality: 'Venice', addressRegion: 'FL', addressCountry: 'US' } } : {}),
};
---
<Base title={data.metaTitle} description={data.metaDescription} home jsonLd={jsonLd}>
  <!-- OPENING: a medallion flips and opens onto the site, once per session (src/components/Intro.astro) -->
  {/* not inside Studio's preview: the editor shows the page itself */}
  {!e.on && <Intro slot="intro" />}
  <!-- HERO: static; the title sets itself once on load (under a second) and the page scrolls on normally -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media" aria-hidden="true">
      <div class="river" id="river"></div>
      <div class="rosette turn hero-rosette"></div>
      <div class="veil"></div>
    </div>
    <div class="hero-copy">
      {data.eyebrow && <p class="eyebrow center hero-in" style="--d:0s" {...e(H, 'eyebrow', { raw: data.eyebrow })}><Inscr text={data.eyebrow} /></p>}
      <h1 class="wordmark" id="hero-title" {...e('settings', 'siteName', { panel: true })}>
        <span class="wm-top hero-in" style="--d:.05s">{first}</span>
        {rest && <span class="wm-rest hero-in" style="--d:.15s">{rest}</span>}
      </h1>
      <div class="deco-rule center hero-in in" style="--d:.2s" aria-hidden="true"><i></i><i></i><i></i></div>
      <p class="hero-statement hero-in" style="--d:.25s" {...e(H, 'heading')}>{data.heading}</p>
      <div class="links hero-links hero-in" style="--d:.3s">
        <LinkArrow href="/process"><Ed f={e(H, 'primaryButton')}>{data.primaryButton || 'Our process'}</Ed></LinkArrow>
        <LinkArrow href="/verify"><Ed f={e(H, 'secondaryButton')}>{data.secondaryButton || 'Verify a certificate'}</Ed></LinkArrow>
      </div>
    </div>
  </section>

  <!-- PHOTOS: slow carousel (Pages → Home → Home carousel); marked placeholders until real photos are added -->
  <Carousel slides={slides} doc={ownSlides ? H : 'gallery'} path={ownSlides ? 'carousel' : 'photos'} />

  <!-- NOTABLE COINS (collection "Notable coins"); marked placeholders until real coins are added -->
  <Notable eyebrow={data.notableEyebrow} title={data.notableTitle} intro={data.notableIntro} doc={H} />

  <!-- FOOTAGE I (after patek.com: a full-screen clip that plays while on screen; nothing pins) -->
  {reels[0] && <Reel {...reels[0]} doc={H} />}

  <!-- WHAT WE GRADE (short) -->
  <section class="sec scope rake" aria-labelledby="scope-title">
    <div class="container">
      <div class="sec-head">
        {data.gradeEyebrow && <p class="eyebrow" {...e(H, 'gradeEyebrow', { raw: data.gradeEyebrow })}><Inscr text={data.gradeEyebrow} /></p>}
        <h2 id="scope-title" class="rake-t" {...e(H, 'gradeTitle')}>{data.gradeTitle}</h2>
        <div class="deco-rule" aria-hidden="true"><i></i><i></i><i></i></div>
      </div>
      <ul class="scope-list" {...(data.grades?.length ? {} : e.add(H, 'grades', 'Add the first field'))}>
        {(data.grades ?? []).map((g, i, all) => (
          <li class={`rv draw d${i}`} {...e.item(H, 'grades', i, all.length)}>
            <span class="medallion" {...e(H, `grades.${i}.mark`, { panel: true })}><Mark name={g.mark} /></span>
            <h3 {...e(H, `grades.${i}.title`)}>{g.title}</h3>
            <Prose text={g.text} f={e(H, `grades.${i}.text`)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- THE NINE STEPS -->
  <section class="sec glance rake" aria-labelledby="glance-title">
    <div class="container">
      <Divider kind="micro" class="tight" />
      <div class="glance-grid">
        <div class="sec-head">
          {data.processEyebrow && <p class="eyebrow" {...e(H, 'processEyebrow', { raw: data.processEyebrow })}><Inscr text={data.processEyebrow} /></p>}
          <h2 id="glance-title" class="rake-t" {...e(H, 'processTitle')}>{data.processTitle}</h2>
          <div class="deco-rule" aria-hidden="true"><i></i><i></i><i></i></div>
          {data.processText && <p class="lead" {...e(H, 'processText')}>{data.processText}</p>}
          {data.processLink && <LinkArrow href="/process"><Ed f={e(H, 'processLink')}>{data.processLink}</Ed></LinkArrow>}
        </div>
        <ol class="glance-list">
          {steps.map((s, i) => (
            <li class="rv">
              <span class="numeral">{roman(i + 1)}</span>
              <div>
                <h3 {...e('page:process', `sections.${i}.title`)}>{s.title}</h3>
                {s.summary && <p {...e('page:process', `sections.${i}.summary`)}>{s.summary}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- FOOTAGE II -->
  {reels[1] && <Reel {...reels[1]} doc={H} />}

  <!-- HOLDER (compact): the exploded view assembles on its own when it comes into view (after a watch movement) -->
  <section class="sec holder-sec rake" aria-labelledby="holder-title">
    <div class="container holder-grid">
      <HolderExplode />
      <div class="holder-copy">
        {data.holderEyebrow && <p class="eyebrow" {...e(H, 'holderEyebrow', { raw: data.holderEyebrow })}><Inscr text={data.holderEyebrow} /></p>}
        <h2 id="holder-title" class="rake-t" {...e(H, 'holderTitle')}>{data.holderTitle}</h2>
        <div class="deco-rule" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="rv"><Prose text={data.holderText} f={e(H, 'holderText')} /></div>
        {data.holderLink && <LinkArrow href="/holder"><Ed f={e(H, 'holderLink')}>{data.holderLink}</Ed></LinkArrow>}
      </div>
    </div>
  </section>

  <!-- VERIFY (compact) -->
  <section class="sec verify-sec rake" aria-labelledby="verify-title">
    <div class="container">
      <Divider kind="rosette" class="tight" />
      <div class="cert-panel foil verify-panel deco-frame draw">
        <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
        <div class="rosette" aria-hidden="true"></div>
        <div class="verify-inner">
          <div class="verify-head">
            <span class="foil-seal" aria-hidden="true"></span>
            <div>
              {data.verifyEyebrow && <p class="eyebrow" {...e(H, 'verifyEyebrow', { raw: data.verifyEyebrow })}><Inscr text={data.verifyEyebrow} /></p>}
              <h2 id="verify-title" class="rake-t" {...e(H, 'verifyTitle')}>{data.verifyTitle}</h2>
            </div>
          </div>
          {data.verifyText && <p class="verify-text" {...e(H, 'verifyText')}>{data.verifyText}</p>}
          <form class="verify-form" action="/verify" method="get" role="search">
            <label class="sr-only" for="home-cert">Certificate number</label>
            <div class="inrow">
              <input id="home-cert" name="cert" type="text" required maxlength="100" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="Certificate number" />
              <button class="btn" type="submit">Verify</button>
            </div>
          </form>
        </div>
        <div class="microtext" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  {(hasBody || e.on) && <section class="sec"><div class="container prose" {...e(H, 'body')}><Body of={body} /></div></section>}
</Base>

<script>
  import '../scripts/coin-engine.js';
  import '../scripts/film';
  import '../scripts/carousel';

  // The hero's coin river: slow, faint, purely ambient. No pointer effects, no flips.
  const host = document.getElementById('river');
  if (host && window.CoinEngine) {
    const phone = innerWidth < 600;
    window.CoinEngine.river(host, {
      seed: 2026,
      scale: phone ? 0.62 : innerWidth < 1100 ? 0.78 : 0.95,
      pool: phone ? 8 : 12,
      rotate: -7,
      bleed: [0.14, 0.2],
      fill: true,
      rowGap: 30,
      rows: [
        { d: 92, dir: -1, speed: 7, depth: 'far' },
        { d: 146, dir: 1, speed: 10, depth: 'mid' },
        { d: 200, dir: -1, speed: 14, depth: 'near' },
        { d: 140, dir: 1, speed: 10, depth: 'mid' },
        { d: 100, dir: -1, speed: 7, depth: 'far' },
      ],
    });
  }
</script>
