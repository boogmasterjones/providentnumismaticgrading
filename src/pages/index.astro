---
import '../styles/coin-engine.css';
import '../styles/home.css';
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Prose from '../components/Prose.astro';
import LinkArrow from '../components/LinkArrow.astro';
import HolderExplode from '../components/HolderExplode.astro';
import { loadPage } from '../lib/pages';
import { gallery, settings } from '../lib/site';
import { roman } from '../lib/text';

const { data, Content, hasBody } = await loadPage('home');
const process = await loadPage('process');
const steps = process.data.sections ?? [];
const words = settings.siteName.split(' ');
const first = words[0];
const rest = words.slice(1).join(' ');
// two captions at most: the film is a short scrub (about 1.5 screens of scroll), not a long story
const film = (data.film ?? []).slice(0, 2);

// Organization only: no people, no prices (client request, 2026-11-02).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: settings.siteName,
  url: settings.siteUrl,
  description: data.metaDescription,
  ...(settings.phone ? { telephone: settings.phone } : {}),
  ...(settings.location ? { address: { '@type': 'PostalAddress', addressLocality: 'Venice', addressRegion: 'FL', addressCountry: 'US' } } : {}),
};
---
<Base title={data.metaTitle} description={data.metaDescription} home jsonLd={jsonLd}>
  <!-- HERO: a brief hold (under half a screen) while the title lifts away and the frame closes in (after rolex.com) -->
  <section class="hero-pin" data-progress="pin" aria-labelledby="hero-title">
    <div class="hero">
      <div class="hero-media" aria-hidden="true">
        <div class="river" id="river"></div>
        <div class="rosette turn hero-rosette"></div>
        <div class="veil"></div>
      </div>
      <div class="hero-frame deco-frame" aria-hidden="true"><i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i></div>
      <div class="hero-copy">
        {data.eyebrow && <p class="eyebrow center hero-in" style="--d:.2s">{data.eyebrow}</p>}
        <h1 class="wordmark" id="hero-title">
          <span class="wm-top hero-in" style="--d:.35s">{first}</span>
          {rest && <span class="wm-rest hero-in" style="--d:.6s">{rest}</span>}
        </h1>
        <div class="deco-rule center hero-in in" style="--d:.8s" aria-hidden="true"><i></i><i></i><i></i></div>
        <p class="hero-statement hero-in" style="--d:.95s">{data.heading}</p>
        <div class="links hero-links hero-in" style="--d:1.15s">
          <LinkArrow href="/process">{data.primaryButton || 'Our process'}</LinkArrow>
          <LinkArrow href="/verify">{data.secondaryButton || 'Verify a certificate'}</LinkArrow>
        </div>
      </div>
      <p class="hero-second" aria-hidden="true">Examined <i></i> Recorded <i></i> Sealed</p>
    </div>
  </section>

  <!-- SCOPE -->
  <section class="sec scope rake" aria-labelledby="scope-title">
    <div class="container">
      <div class="sec-head">
        <p class="eyebrow">What we grade</p>
        <h2 id="scope-title" class="rake-t">{data.gradeTitle}</h2>
        <div class="deco-rule" aria-hidden="true"><i></i><i></i><i></i></div>
        {data.gradeIntro && <p class="lead">{data.gradeIntro}</p>}
      </div>
      <ul class="scope-list">
        {(data.grades ?? []).map((g, i) => (
          <li class={`rv draw d${i}`}>
            <span class="medallion"><Mark name={g.mark} /></span>
            <h3>{g.title}</h3>
            <Prose text={g.text} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FILM: scroll scrubs through footage (after patek.com's scroll-driven video) -->
  {film.length > 0 && (
    <section class="film" data-progress="pin" aria-label="How a coin is examined" style={`--n:${film.length}`}>
      <div class="film-stage">
        <canvas class="film-canvas" data-scrub="/media/scrub/coins/" data-frames="80" aria-hidden="true"></canvas>
        <div class="film-grade" aria-hidden="true"></div>
        <div class="film-frame deco-frame" aria-hidden="true"><i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i></div>
        <ol class="film-captions">
          {film.map((f, i) => (
            <li style={`--i:${i}`}>
              <span class="numeral">{roman(i + 1)}</span>
              <h2>{f.title}</h2>
              <Prose text={f.text} />
            </li>
          ))}
        </ol>
        <div class="film-meter" aria-hidden="true"><span></span></div>
      </div>
    </section>
  )}

  <!-- PROCESS AT A GLANCE -->
  <section class="sec glance rake" aria-labelledby="glance-title">
    <div class="container">
      <div class="glance-grid">
        <div class="sec-head">
          <p class="eyebrow">Our process</p>
          <h2 id="glance-title" class="rake-t">{data.processTitle}</h2>
          <div class="deco-rule" aria-hidden="true"><i></i><i></i><i></i></div>
          {data.processText && <p class="lead">{data.processText}</p>}
          <LinkArrow href="/process">Read the full process</LinkArrow>
        </div>
        <ol class="glance-list">
          {steps.map((s, i) => (
            <li class="rv">
              <span class="numeral">{roman(i + 1)}</span>
              <div>
                <h3>{s.title}</h3>
                {s.summary && <p>{s.summary}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- APPROACH -->
  <section class="sec approach rake" aria-labelledby="approach-title">
    <div class="sunburst approach-sun" aria-hidden="true"></div>
    <div class="container">
      <div class="approach-grid">
        <div>
          <p class="eyebrow">Our approach</p>
          <h2 id="approach-title" class="rake-t">{data.approachTitle}</h2>
          <div class="deco-rule" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>
        <div class="approach-text rv">
          <Prose text={data.approachText} />
          <LinkArrow href="/why-provident">Why Provident</LinkArrow>
        </div>
      </div>
      <ul class="principles">
        {(data.principles ?? []).map((p, i) => (
          <li class={`rv draw d${i}`}>
            <Mark name={p.mark} size={40} />
            <h3>{p.title}</h3>
            <Prose text={p.text} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- HOLDER: an exploded view that assembles on its own when it comes into view (after a watch movement) -->
  <section class="sec holder-sec rake" aria-labelledby="holder-title">
    <div class="container holder-grid">
      <HolderExplode />
      <div class="holder-copy">
        <p class="eyebrow">The holder and label</p>
        <h2 id="holder-title" class="rake-t">{data.holderTitle}</h2>
        <div class="deco-rule" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="rv"><Prose text={data.holderText} /></div>
        <LinkArrow href="/holder">About the holder and label</LinkArrow>
      </div>
    </div>
  </section>

  <!-- VERIFY -->
  <section class="sec verify-sec rake" aria-labelledby="verify-title">
    <div class="container">
      <div class="cert-panel foil verify-panel deco-frame draw">
        <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
        <div class="rosette" aria-hidden="true"></div>
        <div class="verify-inner">
          <div class="verify-head">
            <span class="foil-seal" aria-hidden="true"></span>
            <div>
              <p class="eyebrow">Certificate registry</p>
              <h2 id="verify-title" class="rake-t">{data.verifyTitle}</h2>
            </div>
          </div>
          {data.verifyText && <p class="lead">{data.verifyText}</p>}
          <form class="verify-form" action="/verify" method="get" role="search">
            <label class="sr-only" for="home-cert">Certificate number</label>
            <div class="inrow">
              <input id="home-cert" name="cert" type="text" required maxlength="100" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="Certificate number" />
              <button class="btn" type="submit">Verify</button>
            </div>
          </form>
        </div>
        <div class="microtext" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  {hasBody && <section class="sec"><div class="container prose"><Content /></div></section>}

  {gallery.photos.length > 0 && (
    <section class="sec" aria-labelledby="gallery-heading">
      <div class="container">
        <h2 id="gallery-heading">From the grading room</h2>
        <div class="photo-grid">
          {gallery.photos.map((p) => (
            <figure>
              <img src={p.image} alt={p.alt} loading="lazy" decoding="async" />
              {p.caption && <figcaption class="muted">{p.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CODA -->
  <section class="coda home-coda rake" aria-labelledby="coda-title">
    <div class="sunburst coda-sun" aria-hidden="true"></div>
    <div class="rosette turn" aria-hidden="true"></div>
    <div class="container">
      <h2 id="coda-title" class="rake-t">{data.closingTitle}</h2>
      <div class="deco-rule center" aria-hidden="true"><i></i><i></i><i></i></div>
      {data.closingText && <p>{data.closingText}</p>}
      <div class="links">
        <LinkArrow href="/submit">Submissions</LinkArrow>
        <LinkArrow href="/contact">Contact</LinkArrow>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/coin-engine.js';
  import '../scripts/scrub';

  // The hero's coin river: slow, faint, purely ambient. No pointer effects, no flips.
  const host = document.getElementById('river');
  if (host && window.CoinEngine) {
    const phone = innerWidth < 600;
    window.CoinEngine.river(host, {
      seed: 2026,
      scale: phone ? 0.62 : innerWidth < 1100 ? 0.78 : 0.95,
      pool: phone ? 8 : 12,
      rotate: -7,
      bleed: [0.14, 0.2],
      fill: true,
      rowGap: 30,
      rows: [
        { d: 92, dir: -1, speed: 7, depth: 'far' },
        { d: 146, dir: 1, speed: 10, depth: 'mid' },
        { d: 200, dir: -1, speed: 14, depth: 'near' },
        { d: 140, dir: 1, speed: 10, depth: 'mid' },
        { d: 100, dir: -1, speed: 7, depth: 'far' },
      ],
    });
  }
</script>
