# Copy to .env for local work. Never commit real values.
# On Hostinger: hPanel > Websites > the site > Environment variables (or "Import .env"). Saving redeploys the site.
# Every value here is server-side only: none of them is ever sent to the browser or written to the logs.

# The owner's certificate database: a table in his Coda doc (setup steps: docs/CODA_SETUP.md).
# Leave ALL of them empty (or do not add them) to run the Verify page with three clearly labelled DEMO records
# (DEMO-0001..0003). If any one is set, the site uses Coda and shows an error (never demo data) until all are right.
# CODA_DOC_ID: the doc id, or simply the doc's browser link (https://coda.io/d/Name_dAbCdEfGh...); the id is read from it.
# CODA_TABLE_ID: the table's name exactly as shown in Coda (e.g. Certificates), or its id (grid-...).
# CODA_API_TOKEN: a Coda API token restricted to this doc, READ access only. Only ever sent to the Coda API.
# CODA_COLUMN_MAP (optional): JSON, our field -> his column name. Fields left out use these defaults:
#   {"certNumber":"Cert #","coinDescription":"Coin","year":"Year","countryDenomination":"Country/Denomination",
#    "grade":"Grade","strikeScore":"Strike","surfaceScore":"Surface","notes":"Notes","obverseUrl":"Obverse",
#    "reverseUrl":"Reverse","dateGraded":"Date Graded"}
#   A list joins several columns, e.g. "coinDescription":["Year","Denomination","Variety"]; null drops a field.
#   Both photos in one column: give obverseUrl and reverseUrl the same column (1st image = obverse, 2nd = reverse).
# CODA_API_BASE (optional): https://coda.io/apis/v1 (default) or https://docs.superhuman.com/apis/v1.
CODA_DOC_ID=
CODA_TABLE_ID=
CODA_API_TOKEN=
CODA_COLUMN_MAP=
CODA_API_BASE=

# Provident Studio, the owner's editor at /admin (setup: docs/STUDIO_SETUP.md).
# Sign-in. Make the hash and the secret with `npm run studio:hash` (never put the password itself anywhere).
STUDIO_EMAIL=
STUDIO_PASSWORD_HASH=
STUDIO_SESSION_SECRET=
# Storage on the live site: the GitHub App that commits drafts and publishes. Leave all empty locally: Studio then
# edits the files in this folder directly (local mode, publishing is simulated). Paste the private key base64-encoded
# (one line) on Hostinger; real newlines and "\n" escapes are accepted too.
STUDIO_GITHUB_REPO=
STUDIO_GITHUB_APP_ID=
STUDIO_GITHUB_APP_PRIVATE_KEY=
# Optional: STUDIO_GITHUB_INSTALLATION_ID (looked up when empty), STUDIO_LIVE_BRANCH (main),
# STUDIO_DRAFTS_BRANCH (studio-drafts).

# Forms (contact + submission request): emailed over SMTP from a Hostinger mailbox on the site's domain.
# Leave empty locally: under `npm run dev` entries are accepted and only noted in the console.
# SMTP_USER: the sending mailbox, e.g. forms@yourdomain.com (also the From address). SMTP_PASSWORD: its password.
# FORM_TO: where entries go (default SMTP_USER; several addresses comma-separated).
# Optional: SMTP_HOST (smtp.hostinger.com), SMTP_PORT (465), SMTP_SECURE ("false" only for a local test server).
SMTP_USER=
SMTP_PASSWORD=
FORM_TO=

# Database for the lookup cache and Studio's sign-in locks (one table, provident_kv, made on first use).
# Hostinger: hPanel > Databases > MySQL Databases. DB_HOST is 127.0.0.1 there (default; not "localhost").
# Leave empty locally: the cache then lives in .data/kv under `npm run dev`, in memory otherwise.
# Optional: DB_HOST (127.0.0.1), DB_PORT (3306), KV_DIR (a folder for the file store, local work only).
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional, read at build time: extra web addresses the site answers on (comma-separated), e.g. the temporary
# Hostinger address while testing. The address in Studio > Business (siteUrl) and its www twin are always included.
SITE_HOSTS=
